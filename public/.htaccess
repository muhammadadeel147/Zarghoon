Options -MultiViews -Indexes

# ── Redirect favicon.ico to logo.png ─────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^favicon\.ico$ /logo.png [R=301,L]
</IfModule>

# ── Security Headers ──────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header unset X-Powered-By
</IfModule>

# ── Cache busting for hashed assets ──────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"
</IfModule>

# ── SPA Routing (React Router) ────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS — uncomment AFTER confirming SSL is active on cPanel
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP_HOST} !^localhost
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pass PHP contact handler through directly (do not rewrite)
    RewriteRule ^api/contact\.php$ - [L]

    # Allow real files and directories to be served directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Fallback: send all other requests to index.html (SPA)
    RewriteRule ^ /index.html [L]
</IfModule>

# ── Block access to dotfiles (e.g. .env, .git) ───────────────────
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Disable directory listing ─────────────────────────────────────
Options -Indexes
